{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "Resource"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "richtext"
    },
    "image": {
      "type": "component",
      "component": "shared.image",
      "repeatable": false
    },
    "resourceType": {
      "type": "enumeration",
      "enum": [
        "Guide",
        "Ebook",
        "Whitepaper",
        "Tutorial"
      ]
    }
  }
}
